# One GlobalTrip - Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env or .env.local files to version control

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Your Supabase project URL
VITE_SUPABASE_URL=https://sdeyqojklszwarfrputz.supabase.co

# Your Supabase anonymous/public key (safe to expose on client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Your Supabase project ID
VITE_SUPABASE_PROJECT_ID=sdeyqojklszwarfrputz

# ============================================
# CUSTOM AUTH DOMAIN (for branded OAuth)
# ============================================
# Custom auth domain for branded Google OAuth consent screen
# Set this up in Supabase Dashboard → Settings → Custom Domains
VITE_AUTH_DOMAIN=https://auth.oneglobaltrip.com

# ============================================
# SITE CONFIGURATION
# ============================================
# Your production site URL
VITE_SITE_URL=https://oneglobaltrip.com

# ============================================
# GOOGLE OAUTH (Optional - for custom credentials)
# ============================================
# Google OAuth Client ID (public identifier, safe to expose)
# Get this from Google Cloud Console → Credentials
# ONLY needed if you want to reference it in code
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# For local development, use:
# VITE_SITE_URL=http://localhost:5173

# ============================================
# MAPBOX CONFIGURATION
# ============================================
# Get your free token at https://mapbox.com → Account → Tokens
# Free tier: 50,000 map loads/month (plenty for development)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ============================================
# SQUARE PAYMENTS
# ============================================
# Public identifiers from the Square Developer Dashboard → your app → Credentials.
# Without VITE_SQUARE_APPLICATION_ID the checkout shows "payment not available".
#
# The environment follows the application id: an id starting with "sandbox-"
# loads the sandbox SDK, anything else loads production.
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-your-application-id
VITE_SQUARE_LOCATION_ID=your-location-id

# The server side lives in Supabase secrets, NOT here, and must be the same
# environment (the function refuses a browser on the other one):
#   SQUARE_ENVIRONMENT    production (default when unset) or sandbox
#   SQUARE_ACCESS_TOKEN   access token for that environment
#   SQUARE_LOCATION_ID    location id for that environment

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 1. NEVER commit this file with real values to Git
# 2. Google Client SECRET goes ONLY in Supabase Dashboard, NOT here
# 3. All VITE_* variables are exposed to the browser
# 4. Keep service role keys and secrets in Supabase Secrets Manager only
